{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "source": "gentoo_small",
        "padding": {
            "top": 1
        },
        "color": {
            "1": "white",
            "2": "white",
            "3": "white",
            "4": "white",
            "5": "white",
            "6": "white",
            "7": "white",
            "8": "white",
            "9": "white"
        }
    },

    "display": {
        "separator": " ~ "
    },

    "modules": [
        "break",
        {
            "type": "title",
            "format": "{#bright_cyan}{user-name}{#white}@{#bright_cyan}{host-name}"
        },
        {
            "type": "os",
            "key": "$ os    "
        },
        {
            "type": "kernel",
            "key": "$ kernel"
        },
        {
            "type": "host",
            "key": "$ host  "
        },
        {
            "type": "packages",
            "key": "$ pkgs  "
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "$ uptime"
        },
        {
            "type": "memory",
            "key": "$ memory"
        },
        "break"
    ]
}
