[global]
    monitor = 0
    follow = mouse

    width = 340
    height = (0, 180)
    origin = top-right
    offset = (10, 10)
    notification_limit = 5

    gap_size = 5
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 0
    frame_width = 1
    corner_radius = 0

    font = MxPlus IBM VGA 8x16 MidTilde 12
    line_height = 1
    format="<span foreground='#fabd2f'>%s</span>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = true
    ellipsize = middle
    markup = full

    icon_position = off
    show_indicators = false
    stack_duplicates = true
    hide_duplicate_count = false
    sort = update

    background="#282828ff"
    foreground="#ebdbb2ff"
    frame_color="#fabd2fff"
    separator_color="#fabd2fff"
    highlight="#fabd2fff"

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 280
    progress_bar_corner_radius = 0

    timeout = 3

[urgency_low]
    background="#3c3836ff"
    foreground="#a89984ff"
    frame_color="#a89984ff"
    highlight="#a89984ff"
    timeout = 2

[urgency_normal]
    background="#282828ff"
    foreground="#ebdbb2ff"
    frame_color="#fabd2fff"
    highlight="#fabd2fff"
    timeout = 3

[urgency_critical]
    background="#282828ff"
    foreground="#ebdbb2ff"
    frame_color="#fb4934ff"
    highlight="#fb4934ff"
    timeout = 0
