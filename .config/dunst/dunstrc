[global]
    monitor = 0
    follow = mouse
    width = 300
    height = 100
    origin = top-right
    offset = 10x10
    gap_size = 5
    font = monospace 10
    frame_width = 1
    frame_color = "#444444"
    background = "#171717"
    foreground = "#ffffff"
    timeout = 3
    icon_position = off

[urgency_low]
    background = "#171717"
    foreground = "#ffffff"
    timeout = 2

[urgency_normal]
    background = "#171717"
    foreground = "ffffff"
    timeout = 3

[urgency_critical]
    background = "#171717"
    foreground = "#ffffff"
    timeout = 0
