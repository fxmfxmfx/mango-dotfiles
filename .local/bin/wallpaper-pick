#!/usr/bin/env bash
# Local images only; desktop colors are controlled by desktop-theme.
set -euo pipefail
WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Wallpaper}"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
[[ -d "$WALLPAPER_DIR" ]] || { printf 'Missing wallpaper directory: %s\n' "$WALLPAPER_DIR" >&2; exit 1; }
mapfile -d '' -t images < <(find "$WALLPAPER_DIR" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' -o -iname '*.avif' \) -print0 | sort -z)
((${#images[@]})) || exit 0
labels=()
for image in "${images[@]}"; do label=${image#"$WALLPAPER_DIR"/}; labels+=("${label//$'\n'/ }"); done
# Index output keeps filenames separate from rofi display labels.
selected=$(printf '%s\n' "${labels[@]}" | rofi -dmenu -no-custom -format i -p 'wallpaper' -l 8 -theme-str 'window { width: 360px; }') || exit 0
[[ "$selected" =~ ^[0-9]+$ ]] && ((selected < ${#images[@]})) || exit 1
image=${images[selected]}
if ! awww query >/dev/null 2>&1; then
    awww-daemon >/dev/null 2>&1 &
    for ((i=0; i<30; i++)); do
        awww query >/dev/null 2>&1 && break
        sleep 0.1
    done
fi
awww img "$image" --transition-type "${SWWW_TRANSITION:-fade}" --transition-duration "${SWWW_DURATION:-1}" --transition-fps "${SWWW_FPS:-60}"
mkdir -p "$CACHE_DIR"
printf '%s\n' "$image" > "$CACHE_DIR/current_wallpaper"
printf 'image\n' > "$CACHE_DIR/current_wallpaper_mode"
