#!/usr/bin/env python3
# Apply the current palette even when the foot server predates a theme change.
import configparser
import os
from pathlib import Path
import sys
config = configparser.ConfigParser()
config.read(Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config')) / 'foot/foot.ini')
args = ['/usr/bin/footclient']
for key, value in config['colors'].items():
    args += ['-o', f'colors.{key}={value}']
os.execv(args[0], args + sys.argv[1:])
